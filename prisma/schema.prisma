generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb" // ĐỔI SANG MONGODB
  url      = env("DATABASE_URL")
}

model Project {
  // Sửa lại ID theo chuẩn MongoDB
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String   
  code             String?  
  totalLots        Int      
  deadline         DateTime? 
  
  status           String   @default("ACTIVE") 

  chuaBanHanhCount Int      @default(0)
  chuaKiemKeCount  Int      @default(0)
  xacNhanCount     Int      @default(0)
  duThaoCount      Int      @default(0)
  thamDinhCount    Int      @default(0)
  pheDuyetCount    Int      @default(0)

  projectStates    ProjectState[]
  histories        ProjectHistory[] 
  details          ProjectDetail?   

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProjectDetail {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  tienDoDuAn   String? 
  chiTiet      String? 
  donViDoDac   String?
  canBoGPMB    String?
  mo           String?
  ghiChu       String?

  // Sửa lại khóa ngoại (Foreign key) thành ObjectId
  projectId    String  @unique @db.ObjectId
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectState {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String  
  color     String? 
  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  note      String   
  projectId String   @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model DocTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   
  fileBase64  String   
  keys        String[] // LƯU MẢNG TỪ KHÓA
  createdAt   DateTime @default(now())
  status      String   @default("ACTIVE")
  updatedAt   DateTime @updatedAt
  updatedIp   String?
  histories   DocHistory[]
}

model DocHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  templateId  String   @db.ObjectId
  template    DocTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  excelName   String   
  recordCount Int      
  dataSnapshot Json    
  
  createdAt   DateTime @default(now())
}

// --- BẢNG DANH MỤC SẢN PHẨM ---
model Category {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String     @unique
  status       String     @default("ACTIVE")
  isHeaderMenu Boolean    @default(false)
  
  // TẠO PHẢ HỆ: DANH MỤC CHA - CON
  parentId     String?    @db.ObjectId
  parent       Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Category[] @relation("SubCategories")
  
  products     Product[] 
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// --- BẢNG SẢN PHẨM ---
model Product {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String      @unique
  sizes       String[]    // MỚI: Lưu mảng các size hỗ trợ (VD: ["35", "36", "37"])
  image       String?
  status      String      @default("ACTIVE") // ACTIVE, OUT_OF_STOCK, DELETED
  
  categoryId  String      @db.ObjectId
  category    Category    @relation(fields: [categoryId], references: [id])
  
  orderItems  OrderItem[] 
  reviews     Review[]    
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  price         Int
  discountPrice Int?
  stock         Int         @default(0)
  description   String?
}

// --- BẢNG KHÁCH HÀNG ---
model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  phone     String?
  address   String?
  
  orders    Order[]  // 1 Khách hàng có nhiều Đơn hàng
  reviews   Review[] // 1 Khách hàng có nhiều Đánh giá
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- BẢNG ĐƠN HÀNG ---
model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  orderCode   String      @unique
  totalAmount Int
  status      String      @default("PENDING") // PENDING, SHIPPING, COMPLETED, CANCELLED
  
  customerId  String      @db.ObjectId
  customer    Customer    @relation(fields: [customerId], references: [id])
  
  items       OrderItem[] // 1 Đơn hàng gồm nhiều Chi tiết sản phẩm
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// --- BẢNG CHI TIẾT ĐƠN HÀNG ---
model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  quantity  Int
  price     Int     // Lưu lại giá tại thời điểm mua (tránh việc đổi giá sau này làm sai lịch sử)
  
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
}

// --- BẢNG ĐÁNH GIÁ ---
model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  rating     Int      // Từ 1 đến 5 sao
  comment    String?
  
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String   // Lưu mật khẩu (nên hash bằng bcrypt)
  name      String
  phone     String?
  address   String?
  role      String   @default("USER") // "USER" hoặc "ADMIN"
  status    String   @default("ACTIVE") // "ACTIVE" hoặc "BANNED"
  
  // Hỗ trợ kiểm tra đăng nhập đa thiết bị (Lưu token phiên)
  sessionToken String? 
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}